<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       猫又 (Nekomata) - 森に潜む俊敏な化け猫
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>Nekomata</defName>
    <label>nekomata</label>
    <description>年経て妖力を得た猫が変じた化け物。二又に分かれた尾を持ち、木々の間を音もなく駆け抜けて獲物に飛びかかる。人里近くの森でごく稀に目撃される。\n\nA cat that has lived long enough to gain supernatural power and transform into a monster, marked by its forked tail. It darts silently through the trees before pouncing on prey, rarely glimpsed in forests near settlements.</description>
    <statBases>
      <MoveSpeed>5.6</MoveSpeed>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>35</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
    </statBases>
    <race>
      <body>Human</body>
      <baseBodySize>0.9</baseBodySize>
      <baseHealthScale>1.0</baseHealthScale>
      <baseHungerRate>0.6</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>1.2</maxPreyBodySize>
      <leatherDef>RawFur_RareSpecies</leatherDef>
      <meatDef>Meat_Human</meatDef>
      <manhunterOnDamageChance>0.30</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.35</manhunterOnTameFailChance>
      <wildness>1.0</wildness>
      <trainability>None</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>false</hasGenders>
      <lifeExpectancy>25</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.7</minAge></li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>left claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/Nekomata/Nekomata</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.3</drawSize>
      <shadowData><volume>(0.35, 0.4, 0.25)</volume></shadowData>
    </graphicData>
    <thingCategories><li>Animals</li></thingCategories>
  </ThingDef>

  <!-- ============================================================
       妖狐 (Youko) - 荒野を駆ける狡猾な化け狐
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>Youko</defName>
    <label>youko</label>
    <description>妖力を得て人のように立つ化け狐。豊かな尾を持ち、あらゆる獣の中でも屈指の速さで駆け回る。狡猾に獲物との間合いを詰め、隙を見て牙を突き立てる。\n\nA fox that gained supernatural power and now stands upright like a person, with a magnificent tail. Among the fastest of all beasts, it cunningly closes the distance on prey before striking.</description>
    <statBases>
      <MoveSpeed>5.9</MoveSpeed>
      <ComfyTemperatureMin>-15</ComfyTemperatureMin>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
    </statBases>
    <race>
      <body>Human</body>
      <baseBodySize>0.85</baseBodySize>
      <baseHealthScale>0.9</baseHealthScale>
      <baseHungerRate>0.6</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>1.0</maxPreyBodySize>
      <leatherDef>RawFur_RareSpecies</leatherDef>
      <meatDef>Meat_Human</meatDef>
      <manhunterOnDamageChance>0.25</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.35</manhunterOnTameFailChance>
      <wildness>1.0</wildness>
      <trainability>None</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>false</hasGenders>
      <lifeExpectancy>25</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.7</minAge></li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>left claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>7</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>7</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/Youko/Youko</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.3</drawSize>
      <shadowData><volume>(0.35, 0.4, 0.25)</volume></shadowData>
    </graphicData>
    <thingCategories><li>Animals</li></thingCategories>
  </ThingDef>

  <!-- ============================================================
       鬼人 (Oni) - 山野に潜む剛力の巨人
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>Oni</defName>
    <label>oni</label>
    <description>人よりも遥かに大きく、赤黒い肌と角を持つ怪力の巨人。武器を使わずとも、その拳だけで人体を容易く粉砕する。山間の荒れ地に単独で棲み、滅多に人前に姿を現さない。\n\nA hulking, horned giant far larger than any person, with dark reddish skin. Its bare fists can crush a body with ease. It lives alone in rugged mountainous wastes and is rarely seen.</description>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed>
      <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      <ComfyTemperatureMax>38</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
    </statBases>
    <race>
      <body>Human</body>
      <baseBodySize>1.8</baseBodySize>
      <baseHealthScale>2.0</baseHealthScale>
      <baseHungerRate>1.1</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>2.2</maxPreyBodySize>
      <leatherDef>RawFur_RareSpecies</leatherDef>
      <meatDef>Meat_Human</meatDef>
      <manhunterOnDamageChance>0.35</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.45</manhunterOnTameFailChance>
      <wildness>1.0</wildness>
      <trainability>None</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>false</hasGenders>
      <lifeExpectancy>30</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.6</minAge></li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>left fist</label>
        <capacities><li>Blunt</li></capacities>
        <power>14</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right fist</label>
        <capacities><li>Blunt</li></capacities>
        <power>14</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/Oni/Oni</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>2.0</drawSize>
      <shadowData><volume>(0.55, 0.5, 0.4)</volume></shadowData>
    </graphicData>
    <thingCategories><li>Animals</li></thingCategories>
  </ThingDef>

  <!-- ============================================================
       竜人 (Dragonkin) - 秘境に稀に現れる竜の血を引く者
       ============================================================ -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>Dragonkin</defName>
    <label>dragonkin</label>
    <description>竜の血を引くと伝えられる、鱗に覆われた人型の存在。あらゆる秘境にごく稀に現れ、鋭い鉤爪と厚い鱗で並の武装を寄せ付けない。目撃例が極めて少ない伝説的な脅威。\n\nA scaled, humanoid being said to carry the blood of dragons. Rarely encountered in remote wilds anywhere, its sharp talons and thick scales shrug off ordinary weapons - a legendary threat few have lived to describe in detail.</description>
    <statBases>
      <MoveSpeed>5.0</MoveSpeed>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.30</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Heat>0.50</ArmorRating_Heat>
    </statBases>
    <race>
      <body>Human</body>
      <baseBodySize>1.6</baseBodySize>
      <baseHealthScale>2.2</baseHealthScale>
      <baseHungerRate>0.9</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>2.0</maxPreyBodySize>
      <leatherDef>RawFur_RareSpecies</leatherDef>
      <meatDef>Meat_Human</meatDef>
      <manhunterOnDamageChance>0.25</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.5</manhunterOnTameFailChance>
      <wildness>1.0</wildness>
      <trainability>None</trainability>
      <herdAnimal>false</herdAnimal>
      <canBePredatorPrey>true</canBePredatorPrey>
      <hasGenders>false</hasGenders>
      <lifeExpectancy>40</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.15</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>left talon</label>
        <capacities><li>Scratch</li></capacities>
        <power>12</power>
        <cooldownTime>1.9</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right talon</label>
        <capacities><li>Scratch</li></capacities>
        <power>12</power>
        <cooldownTime>1.9</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/Dragonkin/Dragonkin</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.9</drawSize>
      <shadowData><volume>(0.5, 0.5, 0.4)</volume></shadowData>
    </graphicData>
    <thingCategories><li>Animals</li></thingCategories>
  </ThingDef>

</Defs>
