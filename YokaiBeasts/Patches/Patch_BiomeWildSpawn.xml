<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Adds each new creature to the wild-animal spawn tables of vanilla
       biomes. Every operation is wrapped in a conditional so a biome
       that doesn't exist (e.g. different mod/DLC set) is skipped instead
       of causing a patch error. -->

  <!-- ==================== Japanese Wolf ==================== -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="TemperateForest"]/animalCommonalities</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="TemperateForest"]/animalCommonalities</xpath>
      <value><li><animal>JapaneseWolf</animal><commonality>1.0</commonality></li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="BorealForest"]/animalCommonalities</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="BorealForest"]/animalCommonalities</xpath>
      <value><li><animal>JapaneseWolf</animal><commonality>1.4</commonality></li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="Tundra"]/animalCommonalities</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="Tundra"]/animalCommonalities</xpath>
      <value><li><animal>JapaneseWolf</animal><commonality>0.8</commonality></li></value>
    </match>
  </Operation>

