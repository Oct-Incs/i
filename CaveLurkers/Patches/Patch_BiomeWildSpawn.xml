<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Adds CaveLurker to the wild-animal spawn tables of several vanilla
       biomes so it appears as a naturally occurring predator. Each
       operation is wrapped in a conditional so a missing biome (e.g. from
       a different mod set) is skipped instead of causing a patch error. -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="TemperateForest"]/animalCommonalities</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="TemperateForest"]/animalCommonalities</xpath>
      <value>
        <li>
          <animal>CaveLurker</animal>
          <commonality>0.6</commonality>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="TemperateSwamp"]/animalCommonalities</xpath>
