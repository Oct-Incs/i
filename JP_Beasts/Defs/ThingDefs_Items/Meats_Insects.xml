<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="OrganicProductBase">
    <defName>JP_Meat_Arthropleura</defName>
    <label>arthropleura meat</label>
    <description>アースロプレウラの肉。硬く締まっているが、加熱すると食べやすくなる。\n\nMeat from an arthropleura. Tough and dense, but more palatable once cooked.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Meat/JP_Meat_Arthropleura</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Nutrition>0.05</Nutrition>
      <Flammability>0.5</Flammability>
      <FoodPoisonChanceFixedHuman>0.03</FoodPoisonChanceFixedHuman>
      <Mass>0.05</Mass>
      <MarketValue>1.5</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>DesperateOnly</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>3</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>MeatRaw</li></thingCategories>
  </ThingDef>

