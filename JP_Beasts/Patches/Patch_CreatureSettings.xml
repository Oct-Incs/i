<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ============================================================
       JP_Beasts 設定シート (Creature Settings Sheet)
       ============================================================
       このファイル1つで、モンスターごとの下記パラメータを編集できます:
         1) 出現頻度 commonality タグの数値 - バイオームごとの野生出現の重み
         2) 基本肉量 MeatAmount タグの数値  - 屠殺で得られる肉の基礎量
         3) 基本革量 LeatherAmount タグの数値 - 屠殺で得られる革の基礎量
         4) 基本毛量 woolAmount タグの数値  - テイム後の毛刈りで得られる毛の量

       【出現を完全にOFFにしたい場合】
       対象モンスターの「出現頻度」ブロック全体(見出しコメントから
       次の見出しコメントの手前まで)を削除するか、XMLコメントで囲んで
       ください。それだけでそのモンスターは一切自然出現しなくなります
       (テイムして繁殖させることは引き続き可能です)。

       【数値だけ変えたい場合】
       各タグの数値部分だけを書き換えて保存すれば、次回ゲーム起動時から
       反映されます。値は他MODとの相対的な重みなので上限はありません。
       自由に増減してください。

       【肉/革の仕組みについて】
       MeatAmount/LeatherAmount は「体格1.0あたりの基礎量」で、実際の量は
       個体の体格(baseBodySize)を掛けた値になります(体格はDefs/ThingDefs_Races/
       内で定義・バニラのAnimalThingBaseの既定値は肉90・革30相当)。
       ============================================================ -->

  <!-- ==================== ニホンオオカミ (JP_JapaneseWolf) - 出現頻度 ==================== -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="TemperateForest"]/animalCommonalities</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="TemperateForest"]/animalCommonalities</xpath>
      <value><li><animal>JP_JapaneseWolf</animal><commonality>4</commonality></li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="BorealForest"]/animalCommonalities</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="BorealForest"]/animalCommonalities</xpath>
      <value><li><animal>JP_JapaneseWolf</animal><commonality>5.6</commonality></li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="Tundra"]/animalCommonalities</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="Tundra"]/animalCommonalities</xpath>
      <value><li><animal>JP_JapaneseWolf</animal><commonality>3.2</commonality></li></value>
    </match>
  </Operation>

  <!-- 基本肉量・革量: ニホンオオカミ -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="JP_JapaneseWolf"]/statBases</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="JP_JapaneseWolf"]/statBases</xpath>
      <value>
        <MeatAmount>85</MeatAmount>
        <LeatherAmount>30</LeatherAmount>
      </value>
    </match>
  </Operation>

  <!-- 基本毛量(テイム後の毛刈り): ニホンオオカミ -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="JP_JapaneseWolf"]/comps/li[@Class="CompProperties_Shearable"]/woolAmount</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="JP_JapaneseWolf"]/comps/li[@Class="CompProperties_Shearable"]/woolAmount</xpath>
      <value><woolAmount>20</woolAmount></value>
    </match>
  </Operation>

