<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       卵生 (oviparous reproduction) 個体用の卵。
       未受精卵はそのまま食料/売却用アイテム。受精卵は CompProperties_Hatcher
       により一定日数で対応する PawnKindDef の幼体として孵化する。
       ============================================================ -->

  <!-- ================ Adamantite Beast ================ -->

  <ThingDef ParentName="EggFertBase">
    <defName>JP_Egg_AdamantiteFert</defName>
    <label>adamantite egg (fert.)</label>
    <description>アダマンタイトの受精卵。表面は金属質でひんやりと硬い。うまくいけばアダマンタイトの幼体が孵化する。\n\nA fertilized adamantite beast egg. Its shell is cool and metallically hard. Given time, it should hatch into a young adamantite beast.</description>
    <tradeability>None</tradeability>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>1.2</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/Item/Resource/Egg/JP_Egg_Adamantite</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(150, 165, 180)</color>
    </graphicData>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>18</hatcherDaystoHatch>
        <hatcherPawn>JP_AdamantiteBeast</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="EggUnfertBase">
    <defName>JP_Egg_AdamantiteUnfert</defName>
    <label>adamantite egg (unfert.)</label>
    <description>アダマンタイトの未受精卵。孵化はしないが、食用・売却用として扱える。\n\nAn unfertilized adamantite beast egg. It won't hatch, but can be eaten or sold.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Egg/JP_Egg_Adamantite</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(150, 165, 180)</color>
    </graphicData>
    <tradeability>Sellable</tradeability>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>1.2</Mass>
    </statBases>
  </ThingDef>

