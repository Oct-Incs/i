<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ParentName="OrganicProductBase" is the vanilla abstract used for raw
       meat items (no shared "MeatBase" abstract exists). The usual meat
       fields (ingestible/rottable/nutrition/thingCategories) are defined
       directly, matching vanilla raw meat behavior. All obtained by
       butchering the creature's corpse. -->

  <ThingDef ParentName="OrganicProductBase">
    <defName>JP_Meat_Mammoth</defName>
    <label>mammoth meat</label>
    <description>マンモスの肉。並の家畜肉より脂が乗っており、量も多い。\n\nMeat from a mammoth. Richer and more plentiful than ordinary livestock meat.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Meat/JP_Meat_Mammoth</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Nutrition>0.05</Nutrition>
      <Flammability>0.5</Flammability>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
      <Mass>0.05</Mass>
      <MarketValue>2.4</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>DesperateOnly</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>4</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>MeatRaw</li>
    </thingCategories>
  </ThingDef>

