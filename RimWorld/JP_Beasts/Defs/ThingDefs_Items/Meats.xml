  <!-- 共有アイテム: 虫肉 (insect meat)。古代昆虫7種 + 女郎蜘蛛の計8種が
       全てこの1つの実在アイテムを meatDef として直接参照する。
       (以前は meatLabel/meatColor のみで見た目だけ「insect meat」に
       偽装していたが、meatDef を明示的に設定しないと RimWorld は
       ThingDefGenerator_Meat 経由でモンスターごとに別々の暗黙のアイテムを
       自動生成してしまい、ラベルは同じでも在庫上は別物として扱われ、
       スタックがマージされない・調理材料リストに別々に並ぶ、という不具合が
       発生していた。バニラのメガスパイダー/メガスカラブ/スペロピードが
       全て同じ Meat_Megaspider を meatDef として共有しているのと同じ方式。) -->
  <ThingDef ParentName="OrganicProductBase">
    <defName>JP_Meat_Insect</defName>
    <label>insect meat</label>
    <description>古代の巨大昆虫から得られる肉。独特の匂いがあり、人間は好んで食べないが、食料としては十分に使える。\n\nMeat harvested from giant ancient insects. It has a distinctive smell that people find unappetizing, but it is perfectly usable as food.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Meat/JP_Meat_JapaneseWolf</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(60,68,39)</color>
    </graphicData>
    <statBases>
      <Nutrition>0.05</Nutrition>
      <Flammability>0.5</Flammability>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
      <Mass>0.05</Mass>
      <MarketValue>1.6</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>DesperateOnly</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
      <!-- Without these, the game has no way to know this counts as
           "insect meat" for mood purposes - it would just be treated as
           ordinary meat with no aversion penalty. These two vanilla
           ThoughtDefs are the same ones vanilla insectoid meat uses. -->
      <specialThoughtDirect>AteInsectMeatDirect</specialThoughtDirect>
      <specialThoughtAsIngredient>AteInsectMeatAsIngredient</specialThoughtAsIngredient>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>4</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>MeatRaw</li>
    </thingCategories>
  </ThingDef>

